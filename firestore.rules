rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRequiredUserKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'fullName',
        'email',
        'role',
        'isActive',
        'createdAt'
      ]);
    }

    function isValidCustomerCreate() {
      return hasRequiredUserKeys()
        && request.resource.data.id == request.auth.uid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.role == 'customer'
        && request.resource.data.isActive == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
    }

    // The authenticated user's own Firebase Auth email, normalized to
    // lowercase to match technicianInvites document ids.
    function callerEmail() {
      return request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function pendingInviteForCaller() {
      return get(/databases/$(database)/documents/technicianInvites/$(callerEmail())).data;
    }

    function hasRequiredTechnicianUserKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'fullName',
        'email',
        'role',
        'companyId',
        'phone',
        'isActive',
        'createdAt'
      ]);
    }

    // A user may create their own users/{uid} profile as a technician only
    // by claiming a pending invitation created by a company_admin. The role
    // and companyId always come from that trusted invitation, never from
    // anything the registering client supplies directly.
    function isValidTechnicianClaimCreate(uid) {
      let invite = pendingInviteForCaller();
      return request.resource.data.id == uid
        && hasRequiredTechnicianUserKeys()
        && request.resource.data.role == 'technician'
        && request.resource.data.isActive == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && invite.status == 'pending'
        && invite.email == callerEmail()
        && request.resource.data.email == invite.email
        && request.resource.data.companyId == invite.companyId
        && request.resource.data.fullName == invite.fullName
        && request.resource.data.phone == invite.phone;
    }

    function isSafeCustomerProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phone', 'photoUrl', 'updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && (!request.resource.data.keys().hasAny(['photoUrl'])
          || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() <= 2048))
        && (!request.resource.data.keys().hasAny(['phone'])
          || request.resource.data.phone is string)
        && (!request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt is timestamp)
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function signedInUserExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function signedInUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Platform Admin privilege needs BOTH the role and an active account. A
    // deactivated platform admin (or one whose profile has no isActive flag)
    // loses every permission that is granted through this function.
    function isPlatformAdmin() {
      return signedInUserExists()
        && signedInUser().get('role', '') == 'platform_admin'
        && signedInUser().get('isActive', false) == true;
    }

    // Platform Admin may read customer profiles and change exactly these
    // fields on one: isActive (deactivate / reactivate, never a delete) and
    // the ordinary profile fields fullName and phone. id, email, role,
    // companyId, createdAt and any other key stay untouchable, and the
    // profile fields must carry a server timestamp in updatedAt.
    function isPlatformAdminCustomerUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isPlatformAdmin()
        && resource.data.role == 'customer'
        && changed.hasOnly(['isActive', 'fullName', 'phone', 'updatedAt'])
        && (!changed.hasAny(['isActive']) || data.isActive is bool)
        && (!changed.hasAny(['fullName'])
          || (data.fullName is string
            && data.fullName.size() > 0
            && data.fullName.size() <= 100))
        && (!changed.hasAny(['phone'])
          || (data.phone is string && data.phone.size() <= 30))
        && (!changed.hasAny(['fullName', 'phone'])
          || data.updatedAt == request.time)
        && (!changed.hasAny(['updatedAt']) || data.updatedAt == request.time);
    }

    // True when the company no longer exists once this write (or batch) has
    // been applied: it is deleted in the same batch, or was deleted before.
    // Every Platform Admin delete of company-owned data is tied to this, so a
    // live company's data can never be removed on its own.
    function companyIsGoneAfter(companyId) {
      return companyId is string
        && companyId.size() > 0
        && !existsAfter(/databases/$(database)/documents/companies/$(companyId));
    }

    // A company_admin / technician profile whose company document does not exist.
    function isOrphanedStaffProfile() {
      let companyId = resource.data.get('companyId', '');
      return resource.data.get('role', '') in ['company_admin', 'technician']
        && companyId is string
        && companyId.size() > 0
        && !exists(/databases/$(database)/documents/companies/$(companyId));
    }

    // Platform Admin may create a company_admin profile ONLY in the same batch
    // that creates its company. The profile's companyId must be the id of that
    // brand-new company document, so a hand-typed or differently-cased id can
    // never be linked, and an existing company can never gain an admin this
    // way. The account starts with mustChangePassword: true, and its email is
    // the company's login email. No password is stored anywhere in Firestore:
    // it lives only in Firebase Authentication.
    function isPlatformAdminCompanyAdminCreate(uid) {
      let data = request.resource.data;
      return isPlatformAdmin()
        && data.keys().hasOnly([
          'id',
          'fullName',
          'email',
          'role',
          'companyId',
          'isActive',
          'mustChangePassword',
          'createdAt'
        ])
        && data.keys().hasAll([
          'id',
          'fullName',
          'email',
          'role',
          'companyId',
          'isActive',
          'mustChangePassword',
          'createdAt'
        ])
        && data.id == uid
        && data.role == 'company_admin'
        && data.isActive == true
        && data.mustChangePassword == true
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 120
        && data.email is string
        && data.email.size() > 0
        && data.createdAt == request.time
        && data.companyId is string
        && data.companyId.size() > 0
        && !exists(/databases/$(database)/documents/companies/$(data.companyId))
        && existsAfter(/databases/$(database)/documents/companies/$(data.companyId))
        && getAfter(/databases/$(database)/documents/companies/$(data.companyId))
          .data.get('email', '').lower() == data.email;
    }

    // The one edit a company admin may make to the flag: clearing it after
    // choosing their own password. It can only go from true to false, and
    // nothing else in the profile may change with it. (Rules cannot see the
    // password, so this is the app's first-login gate, not a proof.)
    function isPasswordChangeCompletion() {
      let data = request.resource.data;
      return resource.data.role == 'company_admin'
        && resource.data.get('mustChangePassword', false) == true
        && data.diff(resource.data).affectedKeys()
          .hasOnly(['mustChangePassword', 'updatedAt'])
        && data.mustChangePassword == false
        && data.get('updatedAt', null) == request.time;
    }

    // A deactivated account (isActive == false) can no longer place orders or
    // attach receipts, even from a session that was already open. A user with
    // no profile document, or no isActive flag, is not treated as deactivated.
    function callerIsNotDeactivated() {
      return !signedInUserExists()
        || signedInUser().get('isActive', true) != false;
    }

    function isCompanyAdminOf(companyId) {
      return signedInUserExists()
        && signedInUser().role == 'company_admin'
        && signedInUser().keys().hasAny(['companyId'])
        && signedInUser().companyId is string
        && signedInUser().companyId.size() > 0
        && signedInUser().companyId == companyId;
    }

    function isTechnician() {
      return signedInUserExists()
        && signedInUser().role == 'technician';
    }

    // A technician reads their own technician record, matched by the
    // company + email already on their user profile (technician accounts
    // are provisioned outside the app, same as company_admin accounts).
    function isSelfTechnicianRecord(companyId, email) {
      return isTechnician()
        && signedInUser().keys().hasAny(['companyId'])
        && signedInUser().companyId == companyId
        && request.auth.token.email == email;
    }

    function assignedTechnician(technicianId) {
      return get(/databases/$(database)/documents/technicians/$(technicianId)).data;
    }

    // True when the order is assigned to the signed-in technician's own
    // technician record.
    function isMyAssignedOrder() {
      return isTechnician()
        && resource.data.technicianId is string
        && resource.data.technicianId.size() > 0
        && assignedTechnician(resource.data.technicianId).companyId == signedInUser().companyId
        && assignedTechnician(resource.data.technicianId).email == signedInUser().email
        && assignedTechnician(resource.data.technicianId).isActive == true;
    }

    function catalogServiceExists(serviceId) {
      return exists(/databases/$(database)/documents/services/$(serviceId));
    }

    function hasRequiredCategoryKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'name',
        'description',
        'iconName',
        'isActive',
        'createdAt'
      ]);
    }

    function isValidCategoryWrite(categoryId) {
      return hasRequiredCategoryKeys()
        && request.resource.data.id == categoryId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.iconName is string
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp;
    }

    function isValidCategoryCreate(categoryId) {
      return isValidCategoryWrite(categoryId)
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time;
    }

    function isSafeCategoryUpdate(categoryId) {
      return isValidCategoryWrite(categoryId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'description', 'iconName', 'isActive']);
    }

    function hasRequiredServiceKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'categoryId',
        'name',
        'description',
        'isActive',
        'createdAt'
      ]);
    }

    function isValidServiceWrite(serviceId) {
      return hasRequiredServiceKeys()
        && request.resource.data.id == serviceId
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp;
    }

    function isValidServiceCreate(serviceId) {
      return isValidServiceWrite(serviceId)
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time;
    }

    function isSafeServiceUpdate(serviceId) {
      return isValidServiceWrite(serviceId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['categoryId', 'name', 'description', 'isActive']);
    }

    function hasRequiredCompanyServiceKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'companyId',
        'serviceId',
        'isActive',
        'createdAt'
      ]);
    }

    function isValidCompanyServiceWrite(companyServiceId) {
      return hasRequiredCompanyServiceKeys()
        && request.resource.data.id == companyServiceId
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && request.resource.data.serviceId is string
        && request.resource.data.serviceId.size() > 0
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp;
    }

    function isValidCompanyServiceCreate(companyServiceId) {
      return isValidCompanyServiceWrite(companyServiceId)
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time
        && catalogServiceExists(request.resource.data.serviceId);
    }

    function isSafeCompanyServiceUpdate(companyServiceId) {
      return isValidCompanyServiceWrite(companyServiceId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.serviceId == resource.data.serviceId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isActive']);
    }

    match /users/{uid} {
      // Owners read their own profile. Platform Admin can additionally read
      // customer profiles (queries must filter on role == 'customer'), and the
      // company_admin / technician profiles of a company that NO LONGER EXISTS,
      // so those left-over profiles can be cleaned up. The profiles of a live
      // company's people stay unreadable to Platform Admin.
      allow get: if isOwner(uid)
        || (isPlatformAdmin()
          && (resource.data.role == 'customer' || isOrphanedStaffProfile()));

      allow list: if isPlatformAdmin()
        && (resource.data.role == 'customer' || isOrphanedStaffProfile());

      allow create: if (isOwner(uid)
          && request.auth.uid == uid
          && request.resource.data.id == uid
          && (isValidCustomerCreate() || isValidTechnicianClaimCreate(uid)))
        || isPlatformAdminCompanyAdminCreate(uid);

      allow update: if (isOwner(uid)
          && isSafeCustomerProfileUpdate())
        || (isOwner(uid) && isPasswordChangeCompletion())
        || isPlatformAdminCustomerUpdate();

      // Only the company_admin / technician profile of a company that is gone.
      // Customers, Platform Admins and every profile of a live company stay.
      allow delete: if isPlatformAdmin()
        && resource.data.get('role', '') in ['company_admin', 'technician']
        && companyIsGoneAfter(resource.data.get('companyId', ''));
    }

    match /categories/{categoryId} {
      allow get, list: if isSignedIn();

      allow create: if isPlatformAdmin()
        && request.resource.data.id == categoryId
        && isValidCategoryCreate(categoryId);

      allow update: if isPlatformAdmin()
        && isSafeCategoryUpdate(categoryId);

      allow delete: if false;
    }

    match /services/{serviceId} {
      allow get, list: if isSignedIn();

      allow create: if isPlatformAdmin()
        && request.resource.data.id == serviceId
        && isValidServiceCreate(serviceId);

      allow update: if isPlatformAdmin()
        && isSafeServiceUpdate(serviceId);

      allow delete: if false;
    }

    // Optional GPS point (companies and orders). Both values are absent/null,
    // or both are numbers inside the valid latitude/longitude range. Strings
    // and out-of-range values are rejected.
    function isValidCoordinatePair(lat, lng) {
      return (lat == null && lng == null)
        || (lat is number && lng is number
          && lat >= -90 && lat <= 90
          && lng >= -180 && lng <= 180);
    }

    function orderHasDeliveryPoint(data) {
      return data.get('deliveryLatitude', null) != null
        && data.get('deliveryLongitude', null) != null;
    }

    function hasRequiredOrderKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'customerId',
        'companyId',
        'companyName',
        'productId',
        'productName',
        'quantity',
        'unitPrice',
        'productSubtotal',
        'installationSelected',
        'installationFee',
        'deliveryFee',
        'totalAmount',
        'deliveryAddress',
        'contactPhone',
        'deliveryMethod',
        'customerName',
        'paymentStatus',
        'orderStatus',
        'receiptFileName',
        'deliveryLatitude',
        'deliveryLongitude',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidOrderCreate(orderId) {
      return hasRequiredOrderKeys()
        && request.resource.data.id == orderId
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (!request.resource.data.keys().hasAny(['companyName']) || request.resource.data.companyName is string)
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.unitPrice is number
        && request.resource.data.unitPrice >= 0
        && request.resource.data.productSubtotal is number
        && request.resource.data.productSubtotal >= 0
        && request.resource.data.installationSelected is bool
        && request.resource.data.installationFee is number
        && request.resource.data.installationFee >= 0
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0
        && request.resource.data.deliveryAddress is string
        // A typed address, a map point, or both; never neither.
        && (request.resource.data.deliveryAddress.size() > 0
          || orderHasDeliveryPoint(request.resource.data))
        && isValidCoordinatePair(
          request.resource.data.get('deliveryLatitude', null),
          request.resource.data.get('deliveryLongitude', null))
        && (request.resource.data.get('deliveryMethod', 'delivery') != 'pickup'
          || !orderHasDeliveryPoint(request.resource.data))
        && request.resource.data.contactPhone is string
        && request.resource.data.contactPhone.size() > 0
        && (!request.resource.data.keys().hasAny(['deliveryMethod'])
          || request.resource.data.deliveryMethod in ['delivery', 'pickup'])
        && (request.resource.data.get('deliveryMethod', 'delivery') != 'pickup'
          || request.resource.data.deliveryFee == 0)
        && (!request.resource.data.keys().hasAny(['customerName'])
          || request.resource.data.customerName is string)
        && request.resource.data.paymentStatus == 'pending_verification'
        && request.resource.data.orderStatus == 'processing'
        && (request.resource.data.receiptFileName == null || request.resource.data.receiptFileName is string)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function companyAcceptsOrders(companyId) {
      let path = /databases/$(database)/documents/companies/$(companyId);
      return !exists(path)
        || get(path).data.get('status', 'active') == 'active';
    }

    function isCustomerReceiptAttachment(orderId) {
      return resource.data.customerId == request.auth.uid
        && callerIsNotDeactivated()
        && request.resource.data.id == resource.data.id
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.productName == resource.data.productName
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.unitPrice == resource.data.unitPrice
        && request.resource.data.productSubtotal == resource.data.productSubtotal
        && request.resource.data.installationSelected == resource.data.installationSelected
        && request.resource.data.installationFee == resource.data.installationFee
        && request.resource.data.deliveryFee == resource.data.deliveryFee
        && request.resource.data.totalAmount == resource.data.totalAmount
        && request.resource.data.deliveryAddress == resource.data.deliveryAddress
        && request.resource.data.contactPhone == resource.data.contactPhone
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.orderStatus == resource.data.orderStatus
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptFileName', 'updatedAt'])
        && request.resource.data.receiptFileName is string
        && request.resource.data.receiptFileName.size() > 0;
    }

    function isAllowedOrderStatusTransition(fromStatus, toStatus) {
      return fromStatus == toStatus
        || (fromStatus == 'processing'
          && toStatus in ['out_for_delivery', 'completed'])
        || (fromStatus == 'out_for_delivery' && toStatus == 'completed');
    }

    function isValidTechnicianAssignment() {
      return resource.data.installationSelected == true
        && request.resource.data.technicianId is string
        && request.resource.data.technicianId.size() > 0
        && request.resource.data.technicianName is string
        && request.resource.data.technicianName.size() > 0
        // The assigned technician must belong to the same company as the
        // order and must currently be active, even if a tampered client
        // sends a different technicianId.
        && assignedTechnician(request.resource.data.technicianId).companyId == resource.data.companyId
        && assignedTechnician(request.resource.data.technicianId).isActive == true;
    }

    // Company admins may only move an order forward through
    // Processing -> Out for Delivery -> Completed, confirm payment, and
    // assign a technician to the order's installation add-on.
    function isCompanyOrderManagementUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['orderStatus', 'paymentStatus', 'technicianId', 'technicianName', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.paymentStatus in ['pending_verification', 'confirmed']
        && (resource.data.paymentStatus != 'confirmed'
          || request.resource.data.paymentStatus == 'confirmed')
        && isAllowedOrderStatusTransition(
          resource.data.orderStatus,
          request.resource.data.orderStatus
        )
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['technicianId', 'technicianName'])
          || isValidTechnicianAssignment());
    }

    // A technician may only move an assigned order forward through
    // Processing -> Out for Delivery -> Completed; they cannot touch
    // payment status or reassignment.
    function isTechnicianOrderStatusUpdate() {
      return isMyAssignedOrder()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['orderStatus', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && isAllowedOrderStatusTransition(
          resource.data.orderStatus,
          request.resource.data.orderStatus
        );
    }

    // Stock is consumed when an order is placed. An order for a product that
    // has a document must be created in the same transaction that lowers that
    // product's stockCount by exactly the ordered quantity (and records the
    // order id in lastOrderId), and only while enough stock remains. Products
    // with no document (the built-in demo catalogue) have no stock to reserve.
    function orderReservesStock(orderId, productId, quantity) {
      let productPath = /databases/$(database)/documents/products/$(productId);
      return !exists(productPath)
        || (get(productPath).data.get('inStock', true) == true
          // A product without a price cannot be ordered through checkout.
          && get(productPath).data.get('price', null) != null
          && get(productPath).data.stockCount is int
          && get(productPath).data.stockCount >= quantity
          && getAfter(productPath).data.lastOrderId == orderId
          && getAfter(productPath).data.stockCount
            == get(productPath).data.stockCount - quantity);
    }

    // The other half of orderReservesStock: a customer (not only the owning
    // company) may lower a product's stockCount, but only alongside a brand-new
    // order of their own for that product, by exactly that order's quantity,
    // and never below zero. Nothing else on the product can change.
    function isStockReservation(productId) {
      let before = resource.data;
      let after = request.resource.data;
      return isSignedIn()
        && after.diff(before).affectedKeys()
          .hasOnly(['stockCount', 'lastOrderId', 'updatedAt'])
        && after.updatedAt == request.time
        && after.lastOrderId is string
        && after.lastOrderId.size() > 0
        && !exists(/databases/$(database)/documents/orders/$(after.lastOrderId))
        && existsAfter(/databases/$(database)/documents/orders/$(after.lastOrderId))
        && getAfter(/databases/$(database)/documents/orders/$(after.lastOrderId))
          .data.customerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(after.lastOrderId))
          .data.productId == productId
        && before.get('inStock', true) == true
        && before.stockCount is int
        && after.stockCount is int
        && after.stockCount >= 0
        && after.stockCount == before.stockCount
          - getAfter(/databases/$(database)/documents/orders/$(after.lastOrderId))
            .data.quantity;
    }

    function hasValidProductKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'companyId',
        'companyName',
        'name',
        'imageUrl',
        'price',
        'currency',
        'stockCount',
        'inStock',
        'lastOrderId',
        'description',
        'specifications',
        'isDeliveryAvailable',
        'isInstallationAvailable',
        'installationPrice',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidProductData() {
      let data = request.resource.data;
      return hasValidProductKeys()
        && data.companyId is string
        && data.companyId.size() > 0
        && data.companyName is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.imageUrl is string
        // Optional: absent/null means "price on request". A given price must
        // still be a positive number; 0 is never stored as a stand-in.
        && (data.get('price', null) == null
          || (data.price is number && data.price > 0))
        && data.currency == 'SDG'
        && data.stockCount is int
        && data.stockCount >= 0
        && data.inStock is bool
        && data.description is string
        && data.specifications is map
        && data.isDeliveryAvailable is bool
        && data.isInstallationAvailable is bool
        && ((data.isInstallationAvailable == true
            && data.installationPrice is number
            && data.installationPrice > 0)
          || (data.isInstallationAvailable == false
            && data.installationPrice == null))
        && data.updatedAt == request.time;
    }

    match /products/{productId} {
      allow get, list: if isSignedIn();

      allow create: if isCompanyAdminOf(request.resource.data.companyId)
        && request.resource.data.id == productId
        && request.resource.data.createdAt == request.time
        && isValidProductData();

      allow update: if (isCompanyAdminOf(resource.data.companyId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidProductData())
        || isStockReservation(productId);

      // A company admin deletes their own products. Platform Admin can remove
      // a product only in the same batch that deletes (or after it has
      // deleted) its company, so deleting a company can clean up its catalogue
      // but no live company's product can be touched. Orders keep their own
      // copy of the product/company names, so order history is unaffected.
      allow delete: if isCompanyAdminOf(resource.data.companyId)
        || (isPlatformAdmin()
          && resource.data.companyId is string
          && resource.data.companyId.size() > 0
          && !existsAfter(
            /databases/$(database)/documents/companies/$(resource.data.companyId)));
    }

    function hasRequiredTechnicianKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'uid',
        'companyId',
        'fullName',
        'phone',
        'email',
        'isActive',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidTechnicianData() {
      let data = request.resource.data;
      return hasRequiredTechnicianKeys()
        && data.companyId is string
        && data.companyId.size() > 0
        && data.fullName is string
        && data.fullName.size() > 0
        && data.phone is string
        && (data.email == null || data.email is string)
        && (!data.keys().hasAny(['uid']) || data.uid is string)
        && data.isActive is bool
        && data.updatedAt == request.time;
    }

    // A technician may create their own technicians/{uid} record (doc id ==
    // their own Firebase Auth uid) only by claiming a pending invitation;
    // companyId/fullName/phone/email always come from that trusted
    // invitation.
    function isValidTechnicianClaimRecordCreate(technicianId) {
      let invite = pendingInviteForCaller();
      return technicianId == request.auth.uid
        && hasRequiredTechnicianKeys()
        && request.resource.data.id == technicianId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isActive == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && invite.status == 'pending'
        && invite.email == callerEmail()
        && request.resource.data.email == invite.email
        && request.resource.data.companyId == invite.companyId
        && request.resource.data.fullName == invite.fullName
        && request.resource.data.phone == invite.phone;
    }

    match /technicians/{technicianId} {
      allow get, list: if isSignedIn()
        && (isPlatformAdmin()
          || isCompanyAdminOf(resource.data.companyId)
          || isSelfTechnicianRecord(resource.data.companyId, resource.data.email)
          || (isTechnician() && technicianId == request.auth.uid));

      allow create: if (isCompanyAdminOf(request.resource.data.companyId)
          && request.resource.data.id == technicianId
          && request.resource.data.createdAt == request.time
          && isValidTechnicianData())
        || isValidTechnicianClaimRecordCreate(technicianId);

      allow update: if isCompanyAdminOf(resource.data.companyId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidTechnicianData();

      // Removed together with a deleted company (never on their own).
      allow delete: if isPlatformAdmin()
        && companyIsGoneAfter(resource.data.get('companyId', ''));
    }

    function hasRequiredInviteKeys() {
      return request.resource.data.keys().hasOnly([
        'email',
        'fullName',
        'phone',
        'companyId',
        'status',
        'createdAt'
      ]);
    }

    function isValidTechnicianInviteCreate(inviteId) {
      return hasRequiredInviteKeys()
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.email == inviteId
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
    }

    // The invited person claims their own invitation exactly once: only the
    // status/claimedAt/claimedBy fields may change, the invite must still be
    // pending, and the authenticated email must match the invite.
    function isValidInviteClaim(inviteId) {
      return resource.data.status == 'pending'
        && resource.data.email == callerEmail()
        && inviteId == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'claimedAt', 'claimedBy'])
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.claimedAt == request.time;
    }

    match /technicianInvites/{inviteId} {
      // A nonexistent invite (resource == null) is readable so a company
      // admin can check for a free email before inviting, and so a
      // registering user can check whether their email was invited at all,
      // without leaking any other company's invitation data.
      allow get: if isSignedIn()
        && (resource == null
          || isPlatformAdmin()
          || isCompanyAdminOf(resource.data.companyId)
          || resource.data.email == callerEmail());

      allow list: if isSignedIn()
        && (isPlatformAdmin() || isCompanyAdminOf(resource.data.companyId));

      allow create: if isCompanyAdminOf(request.resource.data.companyId)
        && isValidTechnicianInviteCreate(inviteId);

      allow update: if isSignedIn() && isValidInviteClaim(inviteId);

      allow delete: if isPlatformAdmin()
        && companyIsGoneAfter(resource.data.get('companyId', ''));
    }

    function notificationOrder(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    // The company_admin notification for a new order may only be created by
    // the customer who owns that order, targeting the order's own company.
    function isValidCompanyAdminNotificationCreate() {
      let order = notificationOrder(request.resource.data.orderId);
      return order.companyId == request.resource.data.recipientId
        && order.customerId == request.auth.uid;
    }

    // A customer notification may only be created by the company admin of
    // that order, or by the technician currently assigned to it.
    function isValidCustomerNotificationCreate() {
      let order = notificationOrder(request.resource.data.orderId);
      return order.customerId == request.resource.data.recipientId
        && (isCompanyAdminOf(order.companyId)
          || (isTechnician()
            && order.technicianId is string
            && order.technicianId.size() > 0
            && assignedTechnician(order.technicianId).companyId == signedInUser().companyId
            && assignedTechnician(order.technicianId).email == signedInUser().email));
    }

    // A technician notification may only be created by the company admin
    // who assigned that technician to the order.
    function isValidTechnicianNotificationCreate() {
      let order = notificationOrder(request.resource.data.orderId);
      return order.technicianId == request.resource.data.recipientId
        && isCompanyAdminOf(order.companyId);
    }

    function hasRequiredNotificationKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'recipientType',
        'recipientId',
        'orderId',
        'type',
        'title',
        'body',
        'isRead',
        'createdAt'
      ]);
    }

    function isValidNotificationCreate(notificationId) {
      return hasRequiredNotificationKeys()
        && request.resource.data.id == notificationId
        && request.resource.data.recipientType in ['customer', 'company_admin', 'technician']
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.isRead == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
    }

    // A notification's recipient may read it: the customer themself, any
    // admin of the target company, or the technician it was assigned to.
    function isNotificationRecipient() {
      return (resource.data.recipientType == 'customer'
          && resource.data.recipientId == request.auth.uid)
        || (resource.data.recipientType == 'company_admin'
          && isCompanyAdminOf(resource.data.recipientId))
        || (resource.data.recipientType == 'technician'
          && isTechnician()
          && assignedTechnician(resource.data.recipientId).companyId == signedInUser().companyId
          && assignedTechnician(resource.data.recipientId).email == signedInUser().email);
    }

    match /notifications/{notificationId} {
      allow get, list: if isSignedIn()
        && (isPlatformAdmin() || isNotificationRecipient());

      allow create: if isSignedIn()
        && isValidNotificationCreate(notificationId)
        && ((request.resource.data.recipientType == 'company_admin'
              && isValidCompanyAdminNotificationCreate())
          || (request.resource.data.recipientType == 'customer'
              && isValidCustomerNotificationCreate())
          || (request.resource.data.recipientType == 'technician'
              && isValidTechnicianNotificationCreate()));

      allow update: if isSignedIn()
        && (isPlatformAdmin() || isNotificationRecipient())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;

      // Only what was addressed to a deleted company's admin, or to one of its
      // technicians once that technician is gone. A customer's notifications
      // are never deletable.
      allow delete: if isPlatformAdmin()
        && ((resource.data.recipientType == 'company_admin'
            && companyIsGoneAfter(resource.data.recipientId))
          || (resource.data.recipientType == 'technician'
            && resource.data.recipientId is string
            && resource.data.recipientId.size() > 0
            && !existsAfter(
              /databases/$(database)/documents/technicians/$(resource.data.recipientId))));
    }

    function isCompanyProfileUpdate() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'logoUrl',
          'description',
          'city',
          'address',
          'latitude',
          'longitude',
          'phone',
          'email',
          'pickupAddress',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.logoUrl is string
        && data.description is string
        && data.city is string
        && data.address is string
        && data.phone is string
        && data.email is string
        && data.pickupAddress is string
        && isValidCoordinatePair(
          data.get('latitude', null),
          data.get('longitude', null))
        && data.updatedAt == request.time;
    }

    // Platform Admin decides a company's status and nothing else:
    //   pending  -> active | rejected
    //   active   -> inactive
    //   inactive | rejected -> active
    // A company without a stored status counts as active. Profile fields and
    // ownership stay with the company's own admin.
    function isPlatformAdminCompanyStatusUpdate() {
      let current = resource.data.get('status', 'active');
      let next = request.resource.data.get('status', 'active');
      return isPlatformAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ((current == 'pending' && next in ['active', 'rejected'])
          || (current == 'active' && next == 'inactive')
          || (current in ['inactive', 'rejected'] && next == 'active'));
    }

    function optionalString(data, key) {
      return !data.keys().hasAny([key]) || data[key] is string;
    }

    // Platform Admin adds a company as an active, unrated company with only
    // the ordinary profile fields. Linking a company_admin account to it is
    // done separately (users/{uid}.companyId).
    function isValidPlatformAdminCompanyCreate() {
      let data = request.resource.data;
      return isPlatformAdmin()
        && data.keys().hasOnly([
          'name',
          'logoUrl',
          'description',
          'city',
          'address',
          'latitude',
          'longitude',
          'phone',
          'email',
          'pickupAddress',
          'rating',
          'reviewCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll(['name', 'status', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && optionalString(data, 'logoUrl')
        && optionalString(data, 'description')
        && optionalString(data, 'city')
        && optionalString(data, 'address')
        && optionalString(data, 'phone')
        && optionalString(data, 'email')
        && optionalString(data, 'pickupAddress')
        && isValidCoordinatePair(
          data.get('latitude', null),
          data.get('longitude', null))
        && data.status == 'active'
        && data.get('rating', 0) == 0
        && data.get('reviewCount', 0) == 0
        && data.createdAt == request.time
        && data.get('updatedAt', request.time) == request.time;
    }

    // An active company must be deactivated before it can be deleted; a
    // pending, rejected or inactive one can be removed by Platform Admin.
    function isPlatformAdminCompanyDelete() {
      return isPlatformAdmin()
        && resource.data.get('status', 'active') != 'active';
    }

    match /companies/{companyId} {
      allow get, list: if isSignedIn();

      allow create: if isValidPlatformAdminCompanyCreate();

      allow update: if isPlatformAdminCompanyStatusUpdate()
        || (isCompanyAdminOf(companyId) && isCompanyProfileUpdate());

      allow delete: if isPlatformAdminCompanyDelete();
    }

    match /company_services/{companyServiceId} {
      allow get: if isSignedIn()
        && (resource.data.isActive == true
          || isPlatformAdmin()
          || isCompanyAdminOf(resource.data.companyId));

      allow list: if isSignedIn()
        && (resource.data.isActive == true
          || isPlatformAdmin()
          || isCompanyAdminOf(resource.data.companyId));

      allow create: if (isPlatformAdmin()
          || isCompanyAdminOf(request.resource.data.companyId))
        && request.resource.data.id == companyServiceId
        && isValidCompanyServiceCreate(companyServiceId);

      allow update: if (isPlatformAdmin()
          || isCompanyAdminOf(resource.data.companyId))
        && isSafeCompanyServiceUpdate(companyServiceId);

      allow delete: if isPlatformAdmin()
        && companyIsGoneAfter(resource.data.get('companyId', ''));
    }

    match /orders/{orderId} {
      allow get: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
          || isPlatformAdmin()
          || isCompanyAdminOf(resource.data.companyId)
          || isMyAssignedOrder());

      allow list: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
          || isPlatformAdmin()
          || isCompanyAdminOf(resource.data.companyId)
          || isMyAssignedOrder());

      // Platform Admin is read-only on orders: it cannot place or change one.
      // Nobody can place a new order with a company that has been deactivated
      // (a company that is not in Firestore, e.g. demo data, is not blocked).
      allow create: if isSignedIn()
        && !isPlatformAdmin()
        && request.resource.data.id == orderId
        && isValidOrderCreate(orderId)
        && callerIsNotDeactivated()
        && companyAcceptsOrders(request.resource.data.companyId)
        && orderReservesStock(
          orderId,
          request.resource.data.productId,
          request.resource.data.quantity);

      allow update: if isSignedIn()
        && ((isCompanyAdminOf(resource.data.companyId)
            && isCompanyOrderManagementUpdate())
          || isCustomerReceiptAttachment(orderId)
          || isTechnicianOrderStatusUpdate());

      // Order history is permanent: nobody, including Platform Admin and a
      // company cascade delete, can ever delete an order.
      allow delete: if false;
    }

    // Reviews are visible to Platform Admin only, and read-only.
    match /reviews/{reviewId} {
      allow get, list: if isPlatformAdmin();
      allow create, update: if false;
      allow delete: if isPlatformAdmin()
        && companyIsGoneAfter(resource.data.get('companyId', ''));
    }
  }
}
