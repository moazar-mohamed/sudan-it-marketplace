{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flutter-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "web-server", "--web-port", "8080"],
      "port": 8080
    },
    {
      "name": "flutter-web-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8081", "--directory", "build/web_preview"],
      "port": 8081
    },
    {
      "name": "flutter-web-emulator",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8082", "--directory", "build/web_emulator"],
      "port": 8082
    },
    {
      "name": "firebase-emulators",
      "runtimeExecutable": "firebase",
      "runtimeArgs": ["emulators:start", "--only", "auth,firestore", "--project", "sudan-it-marketplace"],
      "port": 9099
    },
    {
      "name": "customer-web-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--prefix", "customer_web", "vite", "preview", "--port", "5195", "--strictPort", "customer_web"],
      "port": 5195
    },
    {
      "name": "customer-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "customer_web", "run", "dev"],
      "port": 5190
    },
    {
      "name": "company-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "company_web", "run", "dev"],
      "port": 5195
    },
    {
      "name": "company-web-emulator",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_EMULATOR=1&& npm --prefix company_web run dev -- --port 5196 --strictPort"],
      "port": 5196
    },
    {
      "name": "platform-admin-web-emulator",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_EMULATOR=1&& npm --prefix platform_admin_web run dev -- --port 5184 --strictPort"],
      "port": 5184
    },
    {
      "name": "platform-admin-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "platform_admin_web", "run", "dev", "--", "--port", "5183"],
      "port": 5183
    }
  ]
}
