rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function signedInUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isCompanyAdminOf(companyId) {
      return isSignedIn()
        && signedInUser().role == 'company_admin'
        && signedInUser().companyId == companyId;
    }

    function isPlatformAdmin() {
      return isSignedIn() && signedInUser().role == 'platform_admin';
    }

    // Payment transfer receipts: only the customer who owns the order may
    // upload one, and only they, the order's company admin, or the
    // platform admin may view it.
    match /receipts/{companyId}/{customerId}/{fileName} {
      allow read: if isSignedIn()
        && (request.auth.uid == customerId
          || isCompanyAdminOf(companyId)
          || isPlatformAdmin());

      allow write: if isSignedIn()
        && request.auth.uid == customerId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if false;
    }

    // Images uploaded from the apps. Each upload is a new file (no overwrite
    // or delete), limited to common image types under 5 MB. Files are shown
    // through their download URLs, so reads only need to work for signed-in
    // users.
    function isImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Company logos: the company's own admin, or Platform Admin when adding
    // a company.
    match /company-logos/{companyId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if (isCompanyAdminOf(companyId) || isPlatformAdmin())
        && isImageUpload();
    }

    // Product pictures: only the owning company's admin.
    match /product-images/{companyId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isCompanyAdminOf(companyId) && isImageUpload();
    }

    // Profile pictures: only the user themself.
    match /profile-images/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isImageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
