rules_version = '2';
// Storage security rules for Sudan ICT Marketplace (sictm.net)
// Paste into: Firebase Console > Storage > Rules > Publish
service firebase.storage {
  match /b/{bucket}/o {
    // Company registration certificates: certs/{companyUid}/{file}
    match /certs/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
    // Product photos: products/{companyUid}/{productId}/{file}
    // Public to view. The company itself (or an admin) may upload / replace / delete, images only, max 3 MB
    // (the site shrinks photos to ~100-300 KB before upload).
    match /products/{uid}/{pid}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == uid
                       || firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)))
                   && (request.resource == null
                       || (request.resource.size < 3 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*')));
    }
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
