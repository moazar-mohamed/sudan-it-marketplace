rules_version = '2';
// Firestore security rules for Sudan ICT Marketplace (sictm.net)
// Paste into: Firebase Console > Firestore Database > Rules > Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(id)   { return signedIn() && request.auth.uid == id; }
    function isAdmin()  { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function changes(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    // Sign-in email (lower case) or phone number of the current user, '' if none.
    function myEmail() { return request.auth.token.get('email', '').lower(); }
    function myPhone() { return request.auth.token.get('phone_number', ''); }
    function invited() {
      return (myEmail() != '' && exists(/databases/$(database)/documents/adminInvites/$(myEmail())))
          || (myPhone() != '' && exists(/databases/$(database)/documents/adminInvites/$(myPhone())));
    }

    // Admins. The FIRST admin is added by hand in the console (document id = admin's UID).
    // After that, admins add/remove admins from the site's Admin Dashboard.
    // A user who was invited (adminInvites/{email or phone}) may create their own admin doc on first sign-in.
    match /admins/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isAdmin() || (isMe(uid) && invited());
      allow update, delete: if isAdmin() && !isMe(uid);
    }

    // Pending admin invites, keyed by lower-case email or +phone.
    match /adminInvites/{key} {
      allow read, delete: if isAdmin() || (signedIn() && (key == myEmail() || key == myPhone()));
      allow create, update: if isAdmin();
    }

    // User profiles: each user owns their own document, but cannot change their role or suspension.
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid) && request.resource.data.role in ['client', 'company']
                       && !('suspended' in request.resource.data);
      allow update: if (isMe(uid) && !changes(['role', 'suspended'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Companies: public to read. Owner edits own profile but cannot approve itself; admin approves.
    match /companies/{cid} {
      allow read: if true;
      allow create: if isMe(cid) && request.resource.data.approved == false;
      allow update: if (isMe(cid) && request.resource.data.approved == resource.data.approved) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products & services: public to read. The owning company writes, but cannot un-hide
    // an item the admin has hidden. Admin can add / edit / hide / delete any item.
    match /products/{pid} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && request.resource.data.cid == request.auth.uid
                                     && request.resource.data.get('hidden', false) == false);
      allow update: if isAdmin() || (signedIn() && resource.data.cid == request.auth.uid
                                     && request.resource.data.cid == request.auth.uid
                                     && request.resource.data.get('hidden', false) == resource.data.get('hidden', false));
      allow delete: if isAdmin() || (signedIn() && resource.data.cid == request.auth.uid);
    }

    // Reviews: public to read; signed-in users write their own.
    // Technician ('tech') and installation-service ('inst') ratings must come from the customer
    // of that order, after they accepted the installation.
    function acceptedJobOf(oid) {
      let o = get(/databases/$(database)/documents/orders/$(oid)).data;
      return o.from == request.auth.uid && o.get('job', {}).get('status', '') == 'accepted';
    }
    match /reviews/{rid} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.from == request.auth.uid
                               && (!(request.resource.data.kind in ['tech', 'inst'])
                                   || acceptedJobOf(request.resource.data.oid));
      allow delete: if isAdmin();
    }

    // Technicians: each company manages its own list; admin sees all.
    // (Customers see the assigned technician's name/level/phone copied into their order.)
    // A technician with a login (techs.uid, created by the company) reads their own record in the
    // technician portal (sictm.net/tech) and may change only: availability, name, phone, "password chosen".
    match /techs/{tid} {
      allow read: if isAdmin() || (signedIn() && (resource.data.cid == request.auth.uid
                                                  || resource.data.uid == request.auth.uid));
      allow create: if isAdmin() || (signedIn() && request.resource.data.cid == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.cid == request.auth.uid
                                     && request.resource.data.cid == request.auth.uid)
                    || (signedIn() && resource.data.uid == request.auth.uid
                        && onlyChanges(['avail', 'name', 'phone', 'pwSet']));
      allow delete: if isAdmin() || (signedIn() && resource.data.cid == request.auth.uid);
    }

    // Technician portal: the technician assigned to an order (orders.techUid) and that order's company.
    function jobParty(oid, cid, tuid) {
      let o = get(/databases/$(database)/documents/orders/$(oid)).data;
      return o.cid == cid && o.techUid == tuid;
    }
    // Technician's notes on a job: the technician writes/deletes; the company reads; the customer never sees them.
    match /techNotes/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.tuid == request.auth.uid
                                                  || resource.data.cid == request.auth.uid));
      allow create: if signedIn() && request.resource.data.tuid == request.auth.uid
                       && request.resource.data.text is string && request.resource.data.text.size() <= 500
                       && jobParty(request.resource.data.oid, request.resource.data.cid, request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.tuid == request.auth.uid);
    }
    // Job chat between the technician ('tech') and the company ('co'). Messages can't be edited.
    match /techChats/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.tuid == request.auth.uid
                                                  || resource.data.cid == request.auth.uid));
      allow create: if signedIn() && request.resource.data.text is string && request.resource.data.text.size() <= 1200
                       && jobParty(request.resource.data.oid, request.resource.data.cid, request.resource.data.tuid)
                       && ((request.resource.data.by == 'tech' && request.resource.data.tuid == request.auth.uid)
                           || (request.resource.data.by == 'co' && (request.resource.data.cid == request.auth.uid || isAdmin())));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Quote requests: customer creates; customer, the company, and admin can read.
    match /inquiries/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid
                                    || resource.data.cid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if (signedIn() && resource.data.cid == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders: customer creates; company may change the status and run the installation job
    // (assign technician, mark installed); the customer may only accept / report a problem /
    // mark rated once the company marked it installed; admin full access.
    // The assigned technician (orders.techUid) reads the order in the technician portal and may only
    // move the job forward: on the way → installed ('done'). They cannot change the technician or anything else.
    function jobSt(d) { return d.get('job', {}).get('status', ''); }
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid
                                    || resource.data.cid == request.auth.uid || isAdmin()
                                    || resource.data.techUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
                       && request.resource.data.status == 'pending'
                       && (!('job' in request.resource.data) || jobSt(request.resource.data) == 'needed');
      allow update: if isAdmin()
                    || (signedIn() && resource.data.cid == request.auth.uid && onlyChanges(['status', 'job', 'techUid'])
                        && (jobSt(request.resource.data) in ['', 'needed', 'assigned', 'done', 'issue']
                            || request.resource.data.get('job', null) == resource.data.get('job', null)))
                    || (signedIn() && resource.data.get('techUid', '') == request.auth.uid && onlyChanges(['job'])
                        && resource.data.status != 'cancelled'
                        && jobSt(resource.data) in ['assigned', 'issue']
                        && jobSt(request.resource.data) in ['assigned', 'issue', 'done']
                        && request.resource.data.job.tech == resource.data.job.tech)
                    || (signedIn() && resource.data.from == request.auth.uid && onlyChanges(['job'])
                        && jobSt(resource.data) in ['done', 'accepted']
                        && jobSt(request.resource.data) in ['accepted', 'issue']
                        && request.resource.data.job.tech == resource.data.job.tech);
      allow delete: if isAdmin();
    }

    // Activity log: anyone signed in records their own actions; it can't be edited.
    // Admin reads everything; a company reads entries about its company; users read their own.
    match /activity/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.cid == request.auth.uid
                                                  || resource.data.by == request.auth.uid));
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
